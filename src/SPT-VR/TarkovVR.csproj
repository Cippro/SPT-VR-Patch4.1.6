<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SPT-VR</AssemblyName>
    <RootNamespace>TarkovVR</RootNamespace>
    <Version>1.3.5.416</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Description>SPT-VR port for SPT 4.1.6; single player</Description>
    <AssemblySearchPaths>{HintPathFromItem};{TargetFrameworkDirectory};{RawFileName}</AssemblySearchPaths>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <Import Project="/workspace/shared/spt-vr-setup/publicized.props" Condition="'$(SptVrReferences)' == '' and Exists('/workspace/shared/spt-vr-setup/publicized.props')" />
  <ItemGroup>
    <!-- Keep legacy integration sources for a separate port; the standalone DLL
         must be discoverable when none of those mods are installed. -->
    <Compile Remove="ModSupport/*Support.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2019.4.39" IncludeAssets="compile" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="AnimationSystem.Types">
      <HintPath>$(SptVrReferences)/Managed/AnimationSystem.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptVrReferences)/Managed/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(SptVrReferences)/Managed/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Cinemachine">
      <HintPath>$(SptVrReferences)/Managed/Cinemachine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(SptVrReferences)/Managed/Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort.Unity">
      <HintPath>$(SptVrReferences)/Managed/Comfort.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CommonExtensions">
      <HintPath>$(SptVrReferences)/Managed/CommonExtensions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ItemComponent.Types">
      <HintPath>$(SptVrReferences)/Managed/ItemComponent.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.CSharp">
      <HintPath>$(SptVrReferences)/Managed/Microsoft.CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SptVrReferences)/Managed/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(SptVrReferences)/Managed/Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SteamVR">
      <HintPath>$(SptVrReferences)/VRManaged/SteamVR.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SteamVR_Actions">
      <HintPath>$(SptVrReferences)/VRManaged/SteamVR_Actions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Postprocessing.Runtime">
      <HintPath>$(SptVrReferences)/Managed/Unity.Postprocessing.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(SptVrReferences)/Managed/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.XR.Management">
      <HintPath>$(SptVrReferences)/VRManaged/Unity.XR.Management.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.XR.OpenVR">
      <HintPath>$(SptVrReferences)/VRManaged/Unity.XR.OpenVR.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(SptVrReferences)/Managed/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SptVrReferences)/Managed/Assembly-CSharp.dll')" Text="Set SptVrReferences to the prepared, publicized SPT 4.1.6 reference directory. See the repository README." />
  </Target>
</Project>
